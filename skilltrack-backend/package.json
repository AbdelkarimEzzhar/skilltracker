{
    "name": "skilltrack-backend",
    "version": "1.0.0",
    "description": "SkillTrack Backend - Academic and Professional Companion Platform",
    "main": "dist/server.js",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc",
        "start": "node dist/server.js",
        "seed": "ts-node seed.ts",
        "seed:admin": "ts-node seed-admin.ts",
        "seed:resources": "ts-node seed-resources.ts",
        "seed:resources:extra": "tsx seed-resources-extra.ts",
        "typecheck": "tsc --noEmit",
        "lint": "eslint src/**/*.ts"
    },
    "keywords": [
        "skilltrack",
        "academic",
        "career",
        "mern"
    ],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "bson": "^6.4.0",
        "bcryptjs": "^2.4.3",
        "cookie-parser": "^1.4.6",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "jsonwebtoken": "^9.0.3",
        "mongoose": "^8.0.3",
        "validator": "^13.11.0"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/cookie-parser": "^1.4.3",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/jsonwebtoken": "^8.5.8",
        "@types/node": "^20.10.6",
        "ts-node": "^10.9.2",
        "tsx": "^4.19.2",
        "typescript": "^5.3.3"
    }
}